<?xml version="1.0" encoding="utf-8"?>
<!--
  Android 11 и ниже (API < 31). На этих версиях действует android:allowBackup,
  который у нас выставлен в false, так что файл — второй эшелон защиты:
  если атрибут когда-нибудь вернут в true, база всё равно не попадёт
  ни в облачный бэкап, ни в `adb backup`.
-->
<full-backup-content>
    <exclude domain="root" path="." />
    <exclude domain="database" path="." />
    <exclude domain="sharedpref" path="." />
    <exclude domain="file" path="." />
    <exclude domain="external" path="." />
</full-backup-content>
